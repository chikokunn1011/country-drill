{
"rules": {
  "stars": "国旗の地や帯に星（五角星など、とがった形）がある。紋章の中だけの星も数える。",
  "cross": "国旗の端から端まで届く十字（北欧十字・ギリシャの十字・ユニオンジャックの十字をふくむ）。紋章の中の小さな十字は数えない。",
  "crescent": "三日月がある。",
  "sun": "太陽（光の線がある円、または「太陽」と公式に説明される円）がある。日本の日の丸もふくむ。",
  "animal": "動物・鳥・虫などの生きものの絵がある（紋章の中もふくむ）。",
  "unionjack": "旗の一部にイギリスの国旗（ユニオンジャック）がある。イギリス自身もふくむ。",
  "vtricolor": "縦に3本の帯で、帯が3色（真ん中に紋章があってもよい）。",
  "htricolor": "横に3本の帯で、帯が3色（真ん中の帯が太い・紋章があってもよい）。",
  "redwhite": "使っている色が赤と白だけ（紋章もふくめて）。"
},
